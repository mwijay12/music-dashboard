        "jsCode": "const body = $json.body;\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!body || !uuid.test(body.jobId || '') || !uuid.test(body.leaseId || '') || typeof body.ok !== 'boolean') throw new Error('Invalid result');\nif (body.type !== 'echo') throw new Error('Echo jobs only');\nconst output = JSON.stringify(body.output ?? null);\nif (output.length > 16000 || (body.error != null && (typeof body.error !== 'string' || body.error.length > 2000))) throw new Error('Result too large');\nreturn [{ json: { args: [body.jobId, body.leaseId, body.ok, output, body.error ?? null] } }];"
