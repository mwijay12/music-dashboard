# Local Express server
PORT=8130
BASE_URL=http://localhost:8130
AUTH_REQUIRED=false

# Google sign-in (required for real accounts, optional for the demo)
GOOGLE_CLIENT_ID=
# Keep the client secret server-side only. Needed later for YouTube OAuth scopes.
GOOGLE_CLIENT_SECRET=
# Required on serverless hosts (Vercel) where no secret file can be written.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ingest pipeline
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Optional storage / live data
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# Any HTTPS URL that returns a PublicSnapshot JSON. /api/snapshot proxies it
# with a 60s cache; leave empty to use the bundled data/live.json.
LIVE_SNAPSHOT_URL=

# Audiomack weekly digest (owner-only ingestion)
# A mailbox rule files the weekly email into one folder; npm run inbox reads it.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
# Gmail app password (2FA required), not your account password.
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
DIGEST_SENDER=audiomack
# DIGEST_STORE=data/audiomack-digest.json

# Audiomack Data API (optional, once an app is approved)
AUDIOMACK_API_TOKEN=
