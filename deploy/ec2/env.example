# /opt/timbre/.env — chmod 600, owned by the timbre service user.
# install.sh generates SESSION_SECRET for you; everything else is manual.

PORT=8130
BASE_URL=https://timbre.example.com
AUTH_REQUIRED=false

# Google sign-in (ID-token flow: the client ID is the only value the browser needs)
GOOGLE_CLIENT_ID=
# Only needed once we add YouTube Analytics OAuth scopes
GOOGLE_CLIENT_SECRET=

# Signs session cookies. 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Audiomack digest polling (npm run inbox)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
DIGEST_SENDER=audiomack
DIGEST_STORE=data/audiomack-digest.json

# Public-source benchmark lookups (optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Optional: require a bearer token on GET /api/digest (set the same value as
# DIGEST_TOKEN on the Vercel project).
DIGEST_TOKEN=

# On the box, leave DIGEST_URL empty — it belongs on the Vercel deployment and
# should point at this server: https://your-domain/api/digest

# Optional: serve a live snapshot from another URL through /api/snapshot
LIVE_SNAPSHOT_URL=
