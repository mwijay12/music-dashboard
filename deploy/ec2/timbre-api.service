[Unit]
Description=Timbre dashboard (Express API + static app)
Documentation=https://github.com/mwijay12/music-dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=timbre
Group=timbre
WorkingDirectory=/opt/timbre
EnvironmentFile=/opt/timbre/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening: the app only needs its own directory plus outbound HTTP.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/timbre/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
