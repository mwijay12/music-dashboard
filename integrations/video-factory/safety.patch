 app = FastAPI(title="VideoFactory API", version="2.0")
 
+# This dashboard contains local automation and credentials. It is NOT a public API.
+# Check the actual peer and browser origin; do not trust proxy headers.
+@app.middleware("http")
+async def local_only_guard(request: Request, call_next):
+    from ipaddress import ip_address
+    from urllib.parse import urlsplit
+    try:
+        is_local = bool(request.client) and ip_address(request.client.host).is_loopback
+    except ValueError:
+        is_local = False
+    host = urlsplit("//" + request.headers.get("host", "")).hostname
+    if not is_local or host not in ("127.0.0.1", "localhost", "::1"):
+        return JSONResponse({"error": "Local access only"}, status_code=403)
+    origin = request.headers.get("origin")
+    if origin and origin != f"{request.url.scheme}://{request.headers.get('host', '')}":
+        return JSONResponse({"error": "Cross-origin access denied"}, status_code=403)
+    if request.headers.get("sec-fetch-site") == "cross-site":
+        return JSONResponse({"error": "Cross-site access denied"}, status_code=403)
+    return await call_next(request)
+
