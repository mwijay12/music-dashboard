{
  "name": "timbre-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:globe": "vite build --config vite.globe.config.ts",
    "build:app": "esbuild app.js --bundle --format=iife --target=es2020 --minify --outfile=bundle.js",
    "build": "npm run build:globe && npm run build:app",
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "typecheck": "tsc --noEmit && tsc -p pipeline/tsconfig.json --noEmit",
    "ingest": "tsx pipeline/src/ingest.ts",
    "build:vercel": "node scripts/build-static.mjs",
    "test": "node --import tsx --test \"pipeline/src/**/*.test.ts\"",
    "digest": "tsx pipeline/src/digest.ts",
    "report": "node scripts/render-report.mjs",
    "inbox": "tsx pipeline/src/inbox.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.3",
    "imapflow": "^2.11.0",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.14.2",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^8.3.6"
  }
}
